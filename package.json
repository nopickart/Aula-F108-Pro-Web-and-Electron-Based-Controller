{
  "name": "f108-pro-web",
  "private": true,
  "version": "1.0.0",
  "description": "Aula F108 Pro Mechanical Keyboard Configurator and Protocol Studio",
  "author": {
    "name": "Aula F108 Community",
    "email": "hebelemocha@gmail.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "dist:linux": "npm rebuild esbuild 2>/dev/null || true; npm run build && npx electron-builder --linux AppImage deb",
    "dist:win": "npm run build && npx electron-builder --win nsis portable",
    "dist:mac": "npm run build && npx electron-builder --mac dmg",
    "dist": "npm run build && npx electron-builder"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.aula.f108pro",
    "productName": "Aula F108 Pro Controller",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/icon.svg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.svg"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
